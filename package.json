{
  "name": "campusbite-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "CampusBite — Smart Campus Canteen Pre-Ordering Platform (MERN Stack)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "test": "node server/test_phase11.js && node server/test_phase12_e2e.js",
    "start": "npm --prefix server start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "campusbite",
    "mern",
    "canteen-food-preorder",
    "react",
    "nodejs",
    "mongodb",
    "express"
  ],
  "author": "CampusBite Engineering",
  "license": "ISC"
}
